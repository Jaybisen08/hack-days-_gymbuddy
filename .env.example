# GymBuddy Environment Configuration Template
# For Render Deployment:
# 1. Add GEMINI_API_KEY to your Render Dashboard -> Environment Variables
# 2. Render will automatically set PORT (e.g. 10000)

# GEMINI_API_KEY: Required for Gemini AI API calls (Coach, Form Analyzer, Workout, Nutrition)
GEMINI_API_KEY="your_gemini_api_key_here"

# PORT: Optional locally (defaults to 3000). Render provides PORT automatically.
PORT=3000

# NODE_ENV: Set to 'production' on Render
NODE_ENV=production

# APP_URL: Optional deployed application URL (e.g. https://your-gymbuddy.onrender.com)
APP_URL="https://your-gymbuddy.onrender.com"
